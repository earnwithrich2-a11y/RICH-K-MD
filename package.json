{
  "name": "richk-md",
  "version": "5.0.0",
  "description": "RICHK-MD, a multi-device WhatsApp bot",
  "main": "./index.js",
  "type": "commonjs",
  "scripts": {
    "predev": "patch-package --error-on-fail",
    "dev": "node index.js",
    "test": "node --test test",
    "validate:startup": "node scripts/smoke-startup.js",
    "postinstall": "patch-package --error-on-fail",
    "prestart": "patch-package --error-on-fail",
    "start": "pm2 start index.js --deep-monitoring --attach --name richk-md",
    "stop": "pm2 stop richk-md",
    "restart": "pm2 restart richk-md && pm2 logs",
    "stash": "git stash && git stash drop"
  },
  "keywords": [
    "richk-md",
    "whatsapp-bot",
    "whatsapp"
  ],
  "author": "RICHK-MD",
  "license": "MIT",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "*",
    "@hapi/boom": "*",
    "@vitalets/google-translate-api": "^9.2.0",
    "acrcloud": "*",
    "adm-zip": "*",
    "audio-decode": "^2.2.3",
    "axios": "^1.2.5",
    "better-sqlite3": "^12.6.2",
    "body-parser": "latest",
    "buffer": "*",
    "cheerio": "^1.2.0",
    "dotenv": "*",
    "express": "^4.19.2",
    "ffmpeg-static": "*",
    "file-type": "17.1.6",
    "fluent-ffmpeg": "*",
    "form-data": "^4.0.1",
    "fs-extra": "^11.1.0",
    "gifted-baileys": "2.5.8",
    "gifted-btns": "file:RICHK-MD-core/buttons-compat",
    "google-tts-api": "*",
    "jimp": "*",
    "mime-types": "^2.1.35",
    "moment-timezone": "^0.5.45",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "patch-package": "^8.0.1",
    "path": "latest",
    "pg": "*",
    "pino": "^7.0.5",
    "pm2": "latest",
    "qrcode-terminal": "^0.12.0",
    "sequelize": "*",
    "sharp": "0.32.6",
    "sqlite3": "5.1.7",
    "stream": "*",
    "util": "*",
    "wa-sticker-formatter": "*",
    "yt-search": "^2.13.1"
  },
  "overrides": {
    "tar": "^7.5.2"
  }
}
