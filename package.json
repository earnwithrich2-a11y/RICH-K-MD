{
  "name": "richk-md",
  "version": "5.0.0",
  "description": "RICHK-MD, a multi-device WhatsApp bot",
  "main": "./index.js",
  "type": "commonjs",
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "scripts": {
    "predev": "node scripts/ensure-transport-patches.js && patch-package --error-on-fail",
    "dev": "node scripts/run-bot.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "validate:startup": "node scripts/smoke-startup.js",
    "lockfile:portable": "node scripts/portable-lockfile.js",
    "postinstall": "node scripts/ensure-transport-patches.js && patch-package --error-on-fail",
    "prestart": "node scripts/ensure-transport-patches.js && patch-package --error-on-fail",
    "start": "node scripts/run-bot.js",
    "start:pm2": "pm2 start index.js --deep-monitoring --attach --name richk-md",
    "stop": "pm2 stop richk-md",
    "restart": "pm2 restart richk-md && pm2 logs",
    "stash": "git stash && git stash drop"
  },
  "keywords": [
    "richk-md",
    "whatsapp-bot",
    "whatsapp"
  ],
  "author": "RICHK-MD",
  "license": "MIT",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@hapi/boom": "10.0.1",
    "@vitalets/google-translate-api": "9.2.1",
    "@whiskeysockets/baileys": "npm:bwmxmdbaileys@1.0.0",
    "acrcloud": "1.4.0",
    "adm-zip": "0.6.1",
    "audio-decode": "2.2.3",
    "axios": "1.20.0",
    "better-sqlite3": "12.11.1",
    "body-parser": "2.3.0",
    "buffer": "6.0.3",
    "cheerio": "1.2.0",
    "dotenv": "18.0.1",
    "express": "4.22.3",
    "ffmpeg-static": "5.3.0",
    "file-type": "17.1.6",
    "fluent-ffmpeg": "2.1.3",
    "form-data": "4.0.6",
    "fs-extra": "11.4.0",
    "gifted-baileys": "file:RICHK-MD-core/transport-compat",
    "gifted-btns": "file:RICHK-MD-core/buttons-compat",
    "google-tts-api": "2.0.2",
    "jimp": "1.6.1",
    "mime-types": "2.1.35",
    "moment-timezone": "0.5.48",
    "node-cache": "5.1.2",
    "node-fetch": "3.3.2",
    "patch-package": "8.0.1",
    "path": "0.12.7",
    "pg": "8.23.0",
    "pino": "7.11.0",
    "pm2": "7.0.4",
    "qrcode-terminal": "0.12.0",
    "sequelize": "6.37.8",
    "sharp": "0.32.6",
    "sqlite3": "5.1.7",
    "stream": "0.0.3",
    "util": "0.12.5",
    "wa-sticker-formatter": "4.4.4",
    "yt-search": "2.13.1"
  },
  "overrides": {
    "tar": "7.5.22"
  }
}
